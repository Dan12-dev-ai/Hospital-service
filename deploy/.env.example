# Copy to deploy/.env on the server (never commit it).
# Secrets: openssl rand -hex 32
# The database owner `hospital` (migrations only).
POSTGRES_PASSWORD=
# The app role `hospital_app` (the API and worker). Hex, as above: it goes
# into a URL. The migrate service creates the role, or sets this password.
APP_DB_PASSWORD=
# The same values as in Endod's deploy/.env:
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=
JITSI_APP_SECRET=
# Endod's key for approving and suspending hospitals (X-Platform-Key).
PLATFORM_ADMIN_KEY=

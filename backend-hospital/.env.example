# Copy to .env (never commit it).
HOSPITAL_ENVIRONMENT=development
# Its own database (not the patient platform's).
HOSPITAL_DATABASE_URL=postgresql+psycopg://hospital:change-me@localhost:5432/hospital
HOSPITAL_CORS_ORIGINS=http://localhost:3000
# One staff sign-in lasts this long (seconds).
HOSPITAL_SESSION_TTL_SECONDS=43200
HOSPITAL_LOGIN_LOCKOUT_ATTEMPTS=8
HOSPITAL_LOGIN_LOCKOUT_MINUTES=15
# Record files (a volume in production).
HOSPITAL_FILES_DIR=./data/files
# The Endod platform API on the private bus network (shared records' files);
# called with HOSPITAL_PLATFORM_ADMIN_KEY.
HOSPITAL_PLATFORM_API_URL=http://localhost:8000
# The master key (32 random bytes) that wraps every hospital's data key. Not
# needed in development (a public development key is used); required elsewhere.
# HOSPITAL_MASTER_KEY_FILE=/run/secrets/master.key
# The integration API (docs/integrations.md): the PEM EC P-256 key that signs
# its access tokens (openssl ecparam -name prime256v1 -genkey -noout -out
# signing.pem). Not needed in development (a key is made at start); without it
# elsewhere the integration API answers 503.
# HOSPITAL_INTEGRATIONS_SIGNING_KEY_FILE=/run/secrets/integrations-signing.pem
# Where nginx publishes the integration API (its token URL is this + /oauth/token).
HOSPITAL_INTEGRATIONS_PUBLIC_URL=http://localhost:8020/integrations/v1

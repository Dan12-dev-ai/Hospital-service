# Copy to .env (never commit it).
HOSPITAL_ENVIRONMENT=development
# Its own database (not the patient platform's).
HOSPITAL_DATABASE_URL=postgresql+psycopg://hospital:change-me@localhost:5432/hospital
HOSPITAL_CORS_ORIGINS=http://localhost:3000
# One staff sign-in lasts this long (seconds).
HOSPITAL_SESSION_TTL_SECONDS=43200
HOSPITAL_LOGIN_LOCKOUT_ATTEMPTS=8
HOSPITAL_LOGIN_LOCKOUT_MINUTES=15
